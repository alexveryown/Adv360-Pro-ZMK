#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 61 62 63 64 65 66 67 60>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 12 13 26 27 44 45 58 59 74 7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        move_top: move_top {
            compatible = "zmk,behavior-tap-dance";
            label = "MOVE_TOP";
            #binding-cells = <0>;
            bindings = <&tile_top>, <&arrange_top>;
        };

        move_bottom: move_bottom {
            compatible = "zmk,behavior-tap-dance";
            label = "MOVE_BOTTOM";
            #binding-cells = <0>;
            bindings = <&tile_bottom>, <&arrange_bottom>;
        };

        move_left: move_left {
            compatible = "zmk,behavior-tap-dance";
            label = "MOVE_LEFT";
            #binding-cells = <0>;
            bindings = <&tile_left>, <&arrange_left>;
        };

        move_right: move_right {
            compatible = "zmk,behavior-tap-dance";
            label = "MOVE_RIGHT";
            #binding-cells = <0>;
            bindings = <&tile_right>, <&arrange_right>;
        };

        fill_return_to_prev_size: fill_return_to_prev_size {
            compatible = "zmk,behavior-tap-dance";
            label = "FILL_RETURN_TO_PREV_SIZE";
            #binding-cells = <0>;
            bindings = <&fill>, <&return_to_previous_size>;
        };
    };

    macros {
        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 1>;
            label = "BT_MAC";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 2>;
            label = "BT_WIN";
        };

        fn_layer_f16: globe_f {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 4 &kp F16>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 4 &kp F16>;

            label = "GLOBE_F";
        };

        tile_left: tile_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp LEFT_ARROW>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp LEFT_ARROW>;

            label = "TILE_LEFT";
        };

        tile_top: tile_top {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp UP_ARROW>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp UP_ARROW>;

            label = "TILE_TOP";
        };

        tile_bottom: tile_bottom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp DOWN_ARROW>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp DOWN_ARROW>;

            label = "TILE_BOTTOM";
        };

        tile_right: tile_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp RIGHT_ARROW>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp RIGHT_ARROW>;

            label = "TILE_RIGHT";
        };

        arrange_left: arrange_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp LEFT_ARROW &kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp LEFT_ARROW &kp LEFT_SHIFT>;

            label = "ARRANGE_LEFT";
        };

        arrange_right: arrange_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp RIGHT_ARROW &kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp RIGHT_ARROW &kp LEFT_SHIFT>;

            label = "ARRANGE_RIGHT";
        };

        arrange_top: arrange_top {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp UP_ARROW &kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp UP_ARROW &kp LEFT_SHIFT>;

            label = "ARRANGE_TOP";
        };

        arrange_bottom: arrange_bottom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp DOWN_ARROW &kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp DOWN_ARROW &kp LEFT_SHIFT>;

            label = "ARRANGE_BOTTOM";
        };

        fill: fill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp F>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp F>;

            label = "FILL";
        };

        return_to_previous_size: return_to_previous_size {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F16 &kp LEFT_CONTROL &kp R>,
                <&macro_release>,
                <&kp F16 &kp LEFT_CONTROL &kp R>;

            label = "RETURN_TO_PREVIOUS_SIZE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            display-name = "Transparent";
            bindings = <
&kp EQUAL   &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &mo 6                                                                   &mo 5          &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q      &kp W     &kp E     &kp R      &kp T   &kp HOME                                                                &kp PAGE_UP    &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESCAPE  &kp A      &kp S     &kp D     &kp F      &kp G   &kp END   &kp LEFT_CONTROL  &kp LEFT_ALT      &kp RIGHT_GUI  &kp RCTRL  &kp PAGE_DOWN  &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X     &kp C     &kp V      &kp B                               &kp HOME          &kp PG_UP                                &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 4       &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL           &kp END           &kp PAGE_DOWN  &kp ENTER  &kp SPACE              &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 4
            >;
        };

        mac {
            display-name = "White";
            bindings = <
&kp EQUAL      &kp N1             &kp N2               &kp N3           &kp N4               &kp N5  &mo 6                                                                               &mo 5      &kp N6  &kp N7                &kp N8            &kp N9               &kp N0                 &kp MINUS
&kp TAB        &kp Q              &kp W                &kp E            &kp R                &kp T   &kp F21                                                                             &kp F23    &kp Y   &kp U                 &kp I             &kp O                &kp P                  &kp BSLH
&kp ESC        &hml LEFT_SHIFT A  &hml LEFT_CONTROL S  &hml LEFT_ALT D  &hml LEFT_COMMAND F  &kp G   &kp F22   &kp LEFT_COMMAND  &kp LEFT_ALT      &kp RIGHT_CONTROL  &kp RIGHT_COMMAND  &kp F24    &kp H   &hmr RIGHT_COMMAND J  &hmr RIGHT_ALT K  &hmr LEFT_CONTROL L  &hmr RIGHT_SHIFT SEMI  &kp SQT
&kp LSHFT      &kp Z              &kp X                &kp C            &kp V                &kp B                               &kp F17           &kp F19                                          &kp N   &kp M                 &kp COMMA         &kp DOT              &kp FSLH               &kp RSHFT
&fn_layer_f16  &kp GRAVE          &kp CAPS             &kp LEFT         &kp RIGHT                    &kp BSPC  &kp DEL           &kp F18           &kp F20            &kp ENTER          &kp SPACE          &kp UP                &kp DOWN          &kp LBKT             &kp RBKT               &mo 4
            >;
        };

        win {
            display-name = "Blue";
            bindings = <
&kp EQUAL   &kp N1             &kp N2               &kp N3           &kp N4               &kp N5  &mo 6                                                                    &mo 5          &kp N6  &kp N7                &kp N8            &kp N9                &kp N0                 &kp MINUS
&kp TAB     &kp Q              &kp W                &kp E            &kp R                &kp T   &kp HOME                                                                 &kp PAGE_UP    &kp Y   &kp U                 &kp I             &kp O                 &kp P                  &kp BSLH
&kp ESCAPE  &hml LEFT_SHIFT A  &hml LEFT_COMMAND S  &hml LEFT_ALT D  &hml LEFT_CONTROL F  &kp G   &kp END   &kp LEFT_CONTROL  &kp LEFT_ALT       &kp LEFT_ALT   &kp RCTRL  &kp PAGE_DOWN  &kp H   &hmr RIGHT_CONTROL J  &hmr RIGHT_ALT K  &hmr RIGHT_COMMAND L  &hmr RIGHT_SHIFT SEMI  &kp SQT
&kp LSHFT   &kp Z              &kp X                &kp C            &kp V                &kp B                               &kp RIGHT_GUI      &kp RIGHT_GUI                            &kp N   &kp M                 &kp COMMA         &kp DOT               &kp FSLH               &kp RSHFT
&mo 4       &kp GRAVE          &kp CAPS             &kp LEFT         &kp RIGHT                    &kp BSPC  &kp DEL           &mo 4              &mo 4          &kp ENTER  &kp SPACE              &kp UP                &kp DOWN          &kp LBKT              &kp RBKT               &mo 4
            >;
        };

        mac_learn {
            display-name = "White";
            bindings = <
&kp EQUAL      &kp N1             &kp N2               &kp N3           &kp N4               &kp N5  &mo 6                                               &mo 5      &kp N6  &kp N7                &kp N8            &kp N9               &kp N0                 &kp MINUS
&kp TAB        &kp Q              &kp W                &kp E            &kp R                &kp T   &kp F21                                             &kp F23    &kp Y   &kp U                 &kp I             &kp O                &kp P                  &kp BSLH
&kp ESC        &hml LEFT_SHIFT A  &hml LEFT_CONTROL S  &hml LEFT_ALT D  &hml LEFT_COMMAND F  &kp G   &kp F22   &none    &none        &none    &none      &kp F24    &kp H   &hmr RIGHT_COMMAND J  &hmr RIGHT_ALT K  &hmr LEFT_CONTROL L  &hmr RIGHT_SHIFT SEMI  &kp SQT
&none          &kp Z              &kp X                &kp C            &kp V                &kp B                      &kp F17      &kp F19                        &kp N   &kp M                 &kp COMMA         &kp DOT              &kp FSLH               &none
&fn_layer_f16  &kp GRAVE          &kp CAPS             &kp LEFT         &kp RIGHT                    &kp BSPC  &kp DEL  &kp F18      &kp F20  &kp ENTER  &kp SPACE          &kp UP                &kp DOWN          &kp LBKT             &kp RBKT               &mo 4
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3      &kp F4                     &kp F5       &kp F6  &trans                                      &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &kp F17     &move_top                  &kp F19      &trans  &trans                                      &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &move_left  &fill_return_to_prev_size  &move_right  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &kp F18     &move_bottom               &kp F13      &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans      &trans                     &trans               &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        kp {
            display-name = "Fn";
            bindings = <
&to 3   &bt_mac  &bt_win  &to 2   &to 1   &to 0   &trans                                      &none   &none   &none   &none   &none   &none   &none
&trans  &trans   &trans   &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
